{
  "name": "aurora-info",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "concurrently -k -n server,web \"PORT=3001 tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/node/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "lint-fix": "eslint src --fix"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@gewis/eslint-config-react": "2.4.0",
    "@gewis/eslint-config-typescript": "2.4.0",
    "@gewis/prettier-config": "2.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "9.39.2",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supertest": "^7.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
